# 阿里云百炼（DashScope）。专属工作空间端点，OpenAI 兼容协议。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen3.7-plus
DASHSCOPE_MODEL_TURBO=qwen-turbo
DASHSCOPE_EMBEDDING_MODEL=qwen3.7-text-embedding

# RAG 检索参数（可选，不填用代码里的默认值）
# RAG_TOP_K=4
# RAG_SCORE_THRESHOLD=0.45
